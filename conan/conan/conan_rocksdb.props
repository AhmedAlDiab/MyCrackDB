<?xml version="1.0" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
	<ImportGroup Label="PropertySheets">
		<Import Condition="'$(conan_rocksdb_librocksdb_props_imported)' != 'True'" Project="conan_rocksdb_librocksdb.props"/>
	</ImportGroup>
	<PropertyGroup>
		<conan_rocksdb_props_imported>True</conan_rocksdb_props_imported>
	</PropertyGroup>
</Project>