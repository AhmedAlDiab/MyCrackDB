<?xml version="1.0" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
	<ImportGroup Label="PropertySheets">
		<Import Condition="'$(conan_rocksdb_props_imported)' != 'True'" Project="conan_rocksdb.props"/>
		<Import Condition="'$(conan_openssl_props_imported)' != 'True'" Project="conan_openssl.props"/>
		<Import Condition="'$(conan_zstd_props_imported)' != 'True'" Project="conan_zstd.props"/>
	</ImportGroup>
</Project>